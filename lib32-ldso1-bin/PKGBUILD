# Maintainer: Ketchup901 <ketchup901@riseup.net>

pkgname=lib32-ldso1-bin
pkgver=1.8.5
pkgrel=1
pkgdesc="Old Linux interpreters"
arch=('x86_64')
url="https://www.gnu.org/software/cpplib/"
license=('GPL-2.0-or-later')
provides=(
    'ld-linux.so=1'
    'ld.so=1'
    'libdl.so=1'
)
options=(!strip !debug)
source=("https://archive.debian.org/debian/dists/rex/main/binary-i386/base/ldso_$pkgver-1.deb")
sha256sums=('3f1e2d1e297a20da3137ccab43117bda0c67af6fd4b7e9d16ece131333a92a31')

prepare() {
    tar -xf data.tar.gz
}

package() {
    install -Dm755 lib/ld-linux.so.$pkgver -t "$pkgdir/usr/lib32/"
    ln -s "ld-linux.so.$pkgver" "$pkgdir/usr/lib32/ld-linux.so.1"
    install -Dm755 lib/ld.so.$pkgver -t "$pkgdir/usr/lib32/"
    ln -s "ld.so.$pkgver" "$pkgdir/usr/lib32/ld.so.1"
    install -Dm755 lib/libdl.so.$pkgver -t "$pkgdir/usr/lib32/"
    ln -s "libdl.so.$pkgver" "$pkgdir/usr/lib32/libdl.so.1"
    ln -s "libdl.so.1" "$pkgdir/usr/lib32/libdl.so"
}

