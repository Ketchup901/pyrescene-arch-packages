noextract=("${source[@]##*/}")

prepare() {
    echo -n "Extracting RAR20LNX.SFX -> "
    date=$(rar l RAR20LNX.SFX rar | awk '$NF == "rar" {print $3}')
    rar p RAR20LNX.SFX rar > ${date}_rar200b3
    echo "${date}_rar200b3"
    
    for archive in rarln202.sfx rarlnx25.sfx rlnx26b{5,6}.sfx; do
        echo -n "Extracting $archive -> "
        date=$(rar l $archive rar | awk '$NF == "rar" {print $3}')
        version=$(echo $archive | sed -E 's/ra?r?lnx?//;s/^([0-9]{2})([b\.])/\10\2/;s/\.sfx//')
        rar p $archive rar > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlnx{26,28,29}.sfx rarln271.sfx rlnx29b{1,2}.sfx; do
        echo -n "Extracting $archive -> "
        date=$(rar l $archive rar/rar | awk '$NF == "rar/rar" {print $3}')
        version=$(echo $archive | sed -E 's/ra?r?lnx?//;s/^([0-9]{2})([b\.])/\10\2/;s/\.sfx//')
        rar p $archive rar/rar > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlinux-3.0*.tar.gz rarlinux-3.1.b*.tar.gz; do
        echo -n "Extracting $archive -> "
        date=$(tar -tvf $archive rar/rar | awk '{print $4}')
        version=$(echo $archive | sed -E 's/rarlinux-//;s/^([0-9]\.[0-9]\.)([bt])/\10\2/;s/\.//g;s/targz//')
        tar -xOf $archive rar/rar > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlinux-3.1.{0,1}.tar.gz rarlinux-3.[!01]*.tar.gz rarlinux-4.0.b*.tar.gz; do
        echo -n "Extracting $archive -> "
        date=$(tar -tvf $archive rar/rar_static | awk '{print $4}')
        version=$(echo $archive | sed -E 's/rarlinux-//;s/^([0-9]\.[0-9]\.)([bt])/\10\2/;s/\.//g;s/targz//')
        tar -xOf $archive rar/rar_static > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlinux-x64-4*.tar.gz rarlinux-x64-5.[0-3]*.tar.gz; do
        echo -n "Extracting $archive -> "
        date=$(tar -tvf $archive rar/rar_static | awk '{print $4}')
        version=$(echo $archive | sed -E 's/rarlinux-x64-//;s/^([0-9]\.[0-9]\.)([bt])/\10\2/;s/\.//g;s/targz//')
        tar -xOf $archive rar/rar_static > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlinux-x64-5.[4-9]*.tar.gz rarlinux-x64-6.*.tar.gz; do
        echo -n "Extracting $archive -> "
        date=$(tar -tvf $archive rar/rar | awk '{print $4}')
        version=$(echo $archive | sed -E 's/rarlinux-x64-//;s/^([0-9]\.[0-9]\.)([bt])/\10\2/;s/\.//g;s/targz//')
        tar -xOf $archive rar/rar > ${date}_rar${version}
        echo "${date}_rar${version}"
    done

    for archive in rarlinux-x64-6[!.]*.tar.gz rarlinux-x64-7*.tar.gz; do
        echo -n "Extracting $archive -> "
        date=$(tar -tvf $archive rar/rar | awk '{print $4}')
        version=$(echo $archive | sed -E 's/rarlinux-x64-(.*).tar.gz/\1/')
        tar -xOf $archive rar/rar > ${date}_rar${version}
        echo "${date}_rar${version}"
    done
}

build() {
    mkdir very_old
    strip 1996-07-16_rar200b3
    patchelf --set-interpreter /usr/lib32/ld-linux.so.1 ./1996-07-16_rar200b3
    patchelf --set-rpath /usr/lib32 ./1996-07-16_rar200b3
    mv 1996-07-16_rar200b3 very_old/
    cat > 1996-07-16_rar200b3 << 'EOF'
#!/bin/bash
export LD_LIBRARY_PATH="/usr/lib32"
exec -a "$0" "$(dirname "$0")/very_old/1996-07-16_rar200b3" "$@"
EOF

    strip 1997-12-29_rar202
    patchelf --set-interpreter /usr/lib32/ld-linux.so.1 ./1997-12-29_rar202
    patchelf --set-rpath /usr/lib32 ./1997-12-29_rar202
    mv 1997-12-29_rar202 very_old/
    cat > 1997-12-29_rar202 << 'EOF'
#!/bin/bash
export LD_LIBRARY_PATH="/usr/lib32"
exec -a "$0" "$(dirname "$0")/very_old/1997-12-29_rar202" "$@"
EOF
}

package() {
    install -Dm755 *_rar* -t "$pkgdir/opt/rarlinux/"
    install -Dm755 very_old/* -t "$pkgdir/opt/rarlinux/very_old/"
}

